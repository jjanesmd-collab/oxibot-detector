    "desc": "GPS casas cambio + precios",
    "precio": 1,
    "html": "<div class='bg-slate-800 rounded-3xl p-5 mb-4'><h2 class='font-bold mb-4 text-base'>📍 Radar Guardian PRO</h2><div class='bg-green-900/30 border border-green-600 rounded-2xl p-3 mb-4 text-xs'><b>GUARDIAN IA:</b> Casas verificadas cerca<br>Actualizado hace 5 min</div><button onclick='activarRadar()' class='w-full bg-blue-600 py-5 rounded-2xl font-bold btn-3d text-lg'><div class='text-4xl mb-1'>📍</div>ACTIVAR RADAR</button><div id='radarLista' class='mt-4 space-y-2'></div></div>",
    "js": "window.activarRadar=()=>{if(!navigator.geolocation){alert('GPS no disponible');return;}navigator.geolocation.getCurrentPosition(p=>{const casas=[{n:'Cambio EL RAYO',c:3.77,v:3.79,d:0.3,r:4.8},{n:'Dólares TRUJILLO',c:3.76,v:3.80,d:0.5,r:4.5},{n:'Yape Agente',c:3.75,v:3.81,d:0.8,r:4.9}];document.getElementById('radarLista').innerHTML=casas.map(c=>`<div class='bg-slate-700 p-3 rounded-xl text-sm'><div class='flex justify-between mb-1'><span class='font-bold'>${c.n}</span><span class='text-yellow-400'>★ ${c.r}</span></div><div class='text-xs text-slate-400 mb-2'>📍 ${c.d}km de ti</div><div class='flex justify-between text-xs'><span class='text-green-400'>Compra: S/${c.c}</span><span class='text-red-400'>Venta: S/${c.v}</span></div></div>`).join('');});};"
  }
