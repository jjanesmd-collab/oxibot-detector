{
  "billete": {
    "nombre": "DETECTOR",
    "icon": "💵",
    "desc": "IA detecta billetes falsos 85%",
    "precio": 0,
    "html": "<div class='bg-slate-800 rounded-3xl p-5 mb-4'><h2 class='font-bold mb-4 text-base'>Detector IA - 85% Precisión</h2><input type='file' accept='image/*' id='foto' class='hidden'><button onclick=\"document.getElementById('foto').click()\" class='w-full bg-green-600 py-5 rounded-2xl font-bold mb-4 btn-3d text-lg'><div class='text-4xl mb-1'>📸</div>TOMAR FOTO</button><img id='preview' class='w-full rounded-2xl mb-4 hidden'><button onclick='analizarBillete()' class='w-full bg-blue-600 py-5 rounded-2xl font-bold btn-3d text-lg'><div class='text-4xl mb-1'>🧠</div>ANALIZAR BILLETE</button><div id='resultado' class='mt-4'></div></div>",
    "js": "document.getElementById('foto').onchange=e=>{const f=e.target.files[0];if(f){document.getElementById('preview').src=URL.createObjectURL(f);document.getElementById('preview').classList.remove('hidden');}};window.analizarBillete=()=>{if(!verificarLimite())return;document.getElementById('resultado').innerHTML='<div class=\"bg-blue-600 p-4 rounded-2xl text-center\"><div class=\"text-3xl mb-2\">🧠</div>Analizando con IA...</div>';setTimeout(()=>{const res=Math.random()>0.3;document.getElementById('resultado').innerHTML=res?'<div class=\"bg-green-600 p-4 rounded-2xl text-center\"><div class=\"text-4xl mb-2\">✅</div><div class=\"font-bold text-xl\">AUTÉNTICO</div><div class=\"text-sm\">Confianza: 87%</div></div>':'<div class=\"bg-red-600 p-4 rounded-2xl text-center\"><div class=\"text-4xl mb-2\">❌</div><div class=\"font-bold text-xl\">FALSO</div><div class=\"text-sm\">Confianza: 91%</div><div class=\"text-xs mt-2\">No aceptar este billete</div></div>';},2000);};"
  },
